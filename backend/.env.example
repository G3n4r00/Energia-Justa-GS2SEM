# Copiar este arquivo para .env e preencher os valores
# O .env real nunca entra no repositório

# Banco de dados SQLite (volume Docker)
DATABASE_URL=sqlite:///./data/energiajusta.db

# Chave do provedor LLM — obtida no Google AI Studio
GEMINI_API_KEY=

# Habilitar rotas de demo/reset (nunca "true" fora do ambiente local)
DEMO_MODE=false
